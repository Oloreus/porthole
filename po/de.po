# German translations for Porthole.
#
# The msgid is the English text from the code; it must match exactly.
# Placeholders like {detail} are filled in by the code and must stay unchanged.
msgid ""
msgstr ""
"Project-Id-Version: porthole\n"
"Language: de\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#: src/app.rs
msgid ""
"Usage: porthole [OPTION]\n"
"  (no option)          Show the window\n"
"  --capture            Take a region screenshot\n"
"  --background         Start in the background only, no window\n"
"  --reset-permission   Delete the stored screenshot permission (you will be asked again)\n"
msgstr ""
"Aufruf: porthole [OPTION]\n"
"  (ohne Option)        Fenster anzeigen\n"
"  --capture            Bereichs-Screenshot starten\n"
"  --background         Nur im Hintergrund starten, kein Fenster\n"
"  --reset-permission   Gespeicherte Screenshot-Berechtigung löschen (es wird neu gefragt)\n"

#: src/capture/mod.rs
msgid ""
"Porthole isn't allowed to take screenshots. Reset the permission with: "
"porthole --reset-permission"
msgstr ""
"Porthole darf keine Screenshots aufnehmen. Berechtigung zurücksetzen mit: "
"porthole --reset-permission"

#: src/capture/mod.rs
msgid ""
"One-time approval needed: please click the camera button here and choose "
"“Allow”. After that the shortcut works from anywhere."
msgstr ""
"Einmalige Freigabe nötig: Bitte hier auf den Kamera-Button klicken und "
"„Erlauben“ wählen. Danach funktioniert das Tastenkürzel von überall."

#: src/capture/mod.rs
msgid "Capture cancelled."
msgstr "Aufnahme abgebrochen."

